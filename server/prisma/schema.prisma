generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// ENUMS
// -----------------------------------------------------

enum AdminStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum ContentType {
  NEWS
  ANNOUNCEMENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventSubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SubmitterType {
  RESIDENT
  ORGANISATION
}

enum OrganisationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum BusinessStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  DOCUMENT
  OTHER
}

// -----------------------------------------------------
// ADMINISTRATION AND ROLE-BASED ACCESS CONTROL
// -----------------------------------------------------

model AdminUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  status       AdminStatus @default(INVITED)
  lastLoginAt  DateTime?

  roles               AdminRole[]
  content             CommunityPost[]
  createdEvents       CommunityEvent[]
  reviewedSubmissions EventSubmission[] @relation("SubmissionReviewer")
  auditLogs           AuditLog[]
  uploadedMedia       MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isSystem    Boolean @default(false)

  administrators AdminRole[]
  permissions    RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model AdminRole {
  adminUserId String
  roleId      String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([adminUserId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// -----------------------------------------------------
// NEWS AND ANNOUNCEMENTS
// -----------------------------------------------------

model CommunityPost {
  id          String        @id @default(cuid())
  type        ContentType
  title       String
  slug        String        @unique
  excerpt     String?
  body        String        @db.Text
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  publishedAt DateTime?

  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([publishedAt])
  @@index([isFeatured])
}

// -----------------------------------------------------
// COMMUNITY ORGANISATIONS
// -----------------------------------------------------

model CommunityOrganisation {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String             @db.Text
  category    String?
  logo        String?
  coverImage  String?
  email       String?
  phone       String?
  website     String?
  address     String?
  facebook    String?
  instagram   String?
  status      OrganisationStatus @default(DRAFT)
  isFeatured  Boolean            @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isFeatured])
}

// -----------------------------------------------------
// EVENTS AND COMMUNITY CALENDAR
// -----------------------------------------------------

model EventCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  events CommunityEvent[]

  createdAt DateTime @default(now())
}

model CommunityEvent {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String  @db.Text
  coverImage  String?

  startAt  DateTime
  endAt    DateTime?
  timezone String    @default("Africa/Johannesburg")
  allDay   Boolean   @default(false)

  venueName String?
  address   String?
  latitude  Float?
  longitude Float?

  status      EventStatus @default(DRAFT)
  publishedAt DateTime?

  categoryId String?
  category   EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id])

  sourceSubmissionId String?          @unique
  sourceSubmission   EventSubmission? @relation("SubmissionPublishedEvent", fields: [sourceSubmissionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt, endAt])
  @@index([status, startAt])
  @@index([categoryId])
}

// -----------------------------------------------------
// PUBLIC EVENT SUGGESTIONS
// -----------------------------------------------------

model EventSubmission {
  id String @id @default(cuid())

  eventTitle       String
  description      String    @db.Text
  suggestedStartAt DateTime
  suggestedEndAt   DateTime?
  timezone         String    @default("Africa/Johannesburg")
  venueName        String?
  address          String?

  submitterType    SubmitterType
  submitterName    String
  submitterEmail   String
  submitterPhone   String?
  organisationName String?

  status EventSubmissionStatus @default(PENDING)

  reviewerId String?
  reviewer   AdminUser? @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  reviewNotes String?
  reviewedAt  DateTime?

  publishedEvent CommunityEvent? @relation("SubmissionPublishedEvent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([submitterEmail])
}

// -----------------------------------------------------
// BUSINESS DIRECTORY
// -----------------------------------------------------

model BusinessCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  sortOrder   Int     @default(0)

  businesses Business[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  tagline     String?
  description String  @db.Text
  coverImage  String?
  logo        String?

  services String[] @default([])

  phone     String?
  whatsapp  String?
  email     String?
  website   String?
  address   String?
  facebook  String?
  instagram String?

  status      BusinessStatus @default(DRAFT)
  isFeatured  Boolean        @default(false)
  publishedAt DateTime?

  categoryId String
  category   BusinessCategory @relation(fields: [categoryId], references: [id])

  images BusinessImage[]
  hours  BusinessHour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
  @@index([isFeatured])
}

model BusinessImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int     @default(0)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([businessId, sortOrder])
}

model BusinessHour {
  id       String  @id @default(cuid())
  day      Int
  opensAt  String?
  closesAt String?
  isClosed Boolean @default(false)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

// -----------------------------------------------------
// MEDIA LIBRARY
// -----------------------------------------------------

model MediaAsset {
  id       String    @id @default(cuid())
  filename String
  url      String
  mimeType String
  type     MediaType @default(IMAGE)
  size     Int?
  altText  String?

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// -----------------------------------------------------
// ADMINISTRATIVE AUDIT LOG
// -----------------------------------------------------

model AuditLog {
  id String @id @default(cuid())

  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  action       String
  resourceType String
  resourceId   String?
  details      Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
